---
import Base from "../layouts/Base.astro";
import Register from "../components/Register.astro";
import { ironic, meta } from "../lib/data";
---

<Base
  title="Inaptonyms: names that cut the other way — theirnames.fit"
  description={`${ironic.length} names that cut the other way: Rob Banks the police officer, Cardinal Sin, Gordon Ramsay the oven cleaner.`}
  path="/inaptronyms"
>
  <section class="titleblock titleblock-tight">
    <div class="wrap">
      <p class="edition"><span>Inaptonyms</span><span>Names that cut the other way</span></p>
      <h1 class="title">And then there are these.</h1>
      <p class="standfirst">
        Rob Banks is a police officer. Cardinal Sin ran the Catholic church in the Philippines.
        Gordon Ramsay cleans ovens. Some names point in the wrong direction.
      </p>
    </div>
  </section>

  <section class="register">
    <div class="wrap">
      <Register list={ironic} head />
      <p class="more">
        <a href="/">The other {meta.total - ironic.length}</a> 
      </p>
      <p class="more">
        <a href="/random" rel="nofollow">See a random aptonym</a>
      </p>
    </div>
  </section>
</Base>
