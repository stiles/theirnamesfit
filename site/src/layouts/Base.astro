---
import "../styles/global.css";
import serif from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url";
import mono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import { meta } from "../lib/data";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, path, image, imageAlt, noindex } = Astro.props;
const url = new URL(path, Astro.site).href;
const ogImage = new URL(image ?? "/og/default.png", Astro.site).href;

const nav = [
  ["/", "The register"],
  ["/fields", "By trade"],
  ["/inaptronyms", "Inaptronyms"],
  ["/about", "About"],
];
const current = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="theirnames.fit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#efe4d4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the register</a>

    <header class="runner">
      <div class="wrap runner-in">
        <a class="mark" href="/">theirnames<span class="mark-tld">.fit</span></a>
        <nav class="nav" aria-label="Sections">
          {
            nav.map(([href, label]) => (
              <a href={href} aria-current={current(href) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="wrap colophon-in">
        <div>
          <p class="col-links">
            <a href="/about">About this project</a>
          </p>
          <p class="col-links">
            <a href="https://github.com/stiles/theirnamesfit">Data and methodology</a>
          </p>
          <p class="col-links">
            <a href="mailto:tips@theirnames.fit?subject=A%20name%20for%20the%20register">Tips? Suggestions? Email us!</a>
          </p>
        </div>
        <dl class="tally">
          <div><dt>Countries</dt><dd>{meta.countries}</dd></div>
          <div><dt>Trades</dt><dd>{meta.fields.length}</dd></div>
          <div><dt>Earliest</dt><dd>{Math.abs(meta.earliestBirth)} <span>BC</span></dd></div>
        </dl>
      </div>
    </footer>
  </body>
</html>
